local Model=require("../src/cine/Model")
local Example=require("../src/cine/Example")
local passed=0
local function eq(a,b) assert(a==b,tostring(a).." ~= "..tostring(b)) end
local function near(a,b) assert(math.abs(a-b)<1e-8,tostring(a).." ~= "..tostring(b)) end
local function test(name,fn) fn() passed+=1 print("PASS "..name) end
local function reject(c,needle) local errors=Model.Validate(c) assert(table.concat(errors,"\n"):find(needle,1,true),table.concat(errors,"\n")) end
test("example and new project validate",function() eq(#Model.Validate(Example),0) eq(#Model.Validate({version=1,projects={Model.Project("new")}}),0) end)
test("all easing curves have exact endpoints",function() for _,kind in ipairs(Model.Easings) do near(Model.Ease(kind,0,2),0) near(Model.Ease(kind,1,2),1) end end)
test("linear smooth ease and custom curves differ",function()
 near(Model.Ease("Linear",0.25,2),0.25) near(Model.Ease("Smooth",0.25,2),0.15625)
 near(Model.Ease("EaseIn",0.25,2),0.0625) near(Model.Ease("EaseOut",0.25,2),0.4375)
 near(Model.Ease("EaseInOut",0.25,2),0.125) near(Model.Ease("Custom",0.5,3),0.125)
end)
test("unsorted camera keys interpolate FOV and effects and clamp outside range",function()
 local a,b=Model.Key(0),Model.Key(10) a.easing="Linear" a.fov=60 b.fov=80 a.fade=0 b.fade=1 a.blur=0 b.blur=20 a.depth=0 b.depth=1
 local keys={b,a} local m=Model.Sample(keys,5) eq(m.left,a) eq(m.right,b) near(m.alpha,0.5) near(m.fov,70) near(m.fade,0.5) near(m.blur,10) near(m.depth,0.5)
 eq(Model.Sample(keys,-1).left,a) eq(Model.Sample(keys,20).right,b)
end)
test("look-at changes when the new key is reached",function() local a,b=Model.Key(0),Model.Key(4) a.lookAt="A" b.lookAt="B" eq(Model.Sample({a,b},2).lookAt,"A") eq(Model.Sample({a,b},4).lookAt,"B") end)
test("scene sequence uses duration boundaries",function()
 local p=Model.Project("q") table.insert(p.scenes,Model.Scene("two")) eq(Model.Duration(p),10)
 local s,t=Model.SceneAt(p,5) eq(s.name,"two") eq(t,0) s,t=Model.SceneAt(p,10) eq(s.name,"two") eq(t,5)
end)
test("clips use start-inclusive end-exclusive intervals",function() local clips={{start=1,duration=2,text="a"}} eq(Model.ClipAt(clips,0),nil) eq(Model.ClipAt(clips,1).text,"a") eq(Model.ClipAt(clips,3),nil) end)
test("character movement interpolates unsorted keys",function()
 local a,b={time=0},{time=10} local l,r,t=Model.Movement({b,a},2.5) eq(l,a) eq(r,b) near(t,0.25) l,r,t=Model.Movement({b,a},11) eq(l,b) eq(r,b) near(t,0)
end)
test("validation rejects missing keys invalid camera FOV and effects",function()
 local c=Model.Clone(Example) c.projects[1].scenes[1].keys={} reject(c,"missing camera keyframes")
 c=Model.Clone(Example) c.projects[1].scenes[1].keys[1].fov=200 reject(c,"FOV")
 c=Model.Clone(Example) c.projects[1].scenes[1].keys[1].fade=2 reject(c,"effects")
 c=Model.Clone(Example) c.projects[1].scenes[1].keys[1].position={0,0/0,0} reject(c,"position")
end)
test("validation rejects duplicate IDs timestamps and duration",function()
 local c=Model.Clone(Example) table.insert(c.projects,Model.Clone(c.projects[1])) reject(c,"duplicate project ID")
 c=Model.Clone(Example) c.projects[1].scenes[1].keys[2].time=0 reject(c,"conflicting keyframe")
 c=Model.Clone(Example) c.projects[1].scenes[1].duration=0 reject(c,"duration")
 c=Model.Clone(Example) c.projects[1].scenes[1].keys[2].time=7 reject(c,"timestamp outside")
end)
test("validation rejects missing animation IDs overlapping clips and duplicate movement",function()
 local c=Model.Clone(Example) local s=c.projects[1].scenes[1]
 s.characters={{path="Rig",animations={{start=0,duration=2,asset=""}},moves={}}} reject(c,"animation asset")
 s.characters[1].animations[1].asset="123" table.insert(s.characters[1].animations,{start=1,duration=2,asset="456"}) reject(c,"overlapping clips")
 s.characters[1].animations[2].start=2 s.characters[1].moves={{time=1,position={0,0,0},rotation={0,0,0}},{time=1,position={0,0,0},rotation={0,0,0}}} reject(c,"conflicting movement")
end)
test("subtitle conflicts are rejected",function() local c=Model.Clone(Example) table.insert(c.projects[1].scenes[1].subtitles,{start=2,duration=1,text="overlap"}) reject(c,"overlapping clips") end)
print("Passed "..passed.." CineForge model scenarios")
